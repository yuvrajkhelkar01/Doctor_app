# Copy to .env.local and fill in from Supabase: Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the web build is hosted, e.g. https://clinic-care.example
# Used to build the public booking form link (Manage my account → Booking form link)
EXPO_PUBLIC_WEB_URL=
